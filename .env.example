# Baatjie Group MCP server — environment
#
# Both keys must be SERVICE ROLE keys, not anon/publishable keys.
# RLS is enabled on every table in both projects with no policies defined, so a
# non-privileged key returns EMPTY RESULT SETS rather than an error — the server
# would report "0 agencies signed" as if it were fact. baatjie_dashboard warns
# when every table reads zero, but do not rely on that as your only check.
#
# Find these in the Supabase dashboard under Project Settings → API → service_role.
# Treat them like passwords: they bypass RLS entirely.

# tanOS — property OS, sales pipeline, sequencing
TANOS_URL=https://tlhzwovsgjptifhnzcvh.supabase.co
TANOS_SERVICE_KEY=

# sigscheCore — multi-brand signal scheduler
SIGSCHE_URL=https://bikmrclrpgxenncqodti.supabase.co
SIGSCHE_SERVICE_KEY=

# Transport: 'stdio' (default, for local MCP clients) or 'http'
TRANSPORT=stdio

# Only used when TRANSPORT=http
PORT=3000
HOST=127.0.0.1
