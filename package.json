{
  "name": "baatjie-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for the Baatjie Group: tanOS (property OS, sales pipeline, sequencing) and sigscheCore (multi-brand signal scheduler)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "baatjie-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test:harness": "node test-harness.mjs",
    "test:rls": "node tests/rls-regression.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
