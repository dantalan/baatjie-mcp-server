 "sprint": [
  {
   "id": "d1-0817",
   "d": 0,
   "t": "08:17",
   "b": "locare",
   "k": "product",
   "hook": "One system. The whole rental lifecycle.",
   "sub": "Leasing, rent collection, trust accounting and owner payouts, under your brand.",
   "body": "Listing to owner statement in one place: leasing, rent collection, trust accounting, owner payouts, maintenance, and apps for tenants and landlords.\n\nAll under your brand and your domain. Tenants never see Locare.\n\nSee it: {link}"
  },
  {
   "id": "d1-1212",
   "d": 0,
   "t": "12:12",
   "b": "node1",
   "k": "proof",
   "hook": "11 units. Zero chasing.",
   "sub": "Node 1 is where _locare was built and tested, on a real property.",
   "body": "Node 1 is where _locare was built: 11 units, run end to end on the same system we sell. Every feature earned its place by fixing a real problem on a real property.\n\nDemo: {link}"
  },
  {
   "id": "d1-1919",
   "d": 0,
   "t": "19:19",
   "b": "baatjie",
   "k": "anime",
   "hook": "Faki'sandla or vokoff.",
   "sub": "Episode 1 of _baatjie: Node One. The tenant meets a ledger that never forgets.",
   "body": "_baatjie: Node One, episode 1.\n\nA tenant who won't pay meets a ledger that doesn't forget. The system wins.\n\nThe demo the episode is built on: {link}"
  },
  {
   "id": "d2-0817",
   "d": 1,
   "t": "08:17",
   "b": "locare",
   "k": "product",
   "hook": "Flat fee. No per-unit maths.",
   "sub": "Starter R6,916 · Growth R14,490 · Scale R25,415 a month, VAT incl.",
   "body": "Starter R6,916/month for 70–199 units.\nGrowth R14,490/month for 200–499.\nScale R25,415/month for 500+.\nVAT included.\n\nYour fee follows your portfolio band, not every new door.\n\n{link}"
  },
  {
   "id": "d2-1111",
   "d": 1,
   "t": "11:11",
   "b": "baatjie",
   "k": "anime",
   "hook": "11|11. The portal opens.",
   "sub": "Episode 5: the house where it all started.",
   "body": "11|11. The portal opens.\n\nEpisode 5 of _baatjie: Node One is the montage of the house where it all started: 11 units, one system, no more WhatsApp debt collection.\n\n{link}"
  },
  {
   "id": "d2-1212",
   "d": 1,
   "t": "12:12",
   "b": "tanos",
   "k": "tenant",
   "hook": "Tenants onboard in 90 seconds.",
   "sub": "Apply, sign, pay and log maintenance from one app.",
   "body": "_tanos is the tenant side of _locare. Tenants apply, sign, pay and log maintenance from one app.\n\nLess admin for your team, fewer calls for you.\n\n{link}"
  },
  {
   "id": "d2-1919",
   "d": 1,
   "t": "19:19",
   "b": "mastandie",
   "k": "white",
   "hook": "Township rentals deserve real systems.",
   "sub": "Proper leases, online rent, receipts tenants trust.",
   "body": "_ma'standie runs on _locare: proper leases, online rent and receipts tenants can trust.\n\nBuilt for the landlords who keep South Africa housed.\n\n{link}"
  },
  {
   "id": "d3-0817",
   "d": 2,
   "t": "08:17",
   "b": "locare",
   "k": "product",
   "hook": "Your brand. Your domain.",
   "sub": "White-label from Growth up. _locare stays behind the scenes.",
   "body": "White-label from the Growth plan up: your logo, your colours, your domain and your own branded rentals site.\n\n_locare stays behind the scenes.\n\n{link}"
  },
  {
   "id": "d3-1212",
   "d": 2,
   "t": "12:12",
   "b": "node1",
   "k": "proof",
   "hook": "Proof beats a pitch deck.",
   "sub": "Rent collected and reconciled on the ledger agencies get.",
   "body": "Before we sold _locare, we ran it.\n\nNode 1: 11 units, rent collected and reconciled through the same double-entry ledger agencies get.\n\n{link}"
  },
  {
   "id": "d3-1919",
   "d": 2,
   "t": "19:19",
   "b": "unuta",
   "k": "media",
   "hook": "Behind the build.",
   "sub": "How one property became a platform.",
   "body": "_unuta media is filming how one property became a platform: the problems Node 1 threw at us, and the features that fixed them.\n\n{link}"
  },
  {
   "id": "d4-0817",
   "d": 3,
   "t": "08:17",
   "b": "locare",
   "k": "product",
   "hook": "Trust accounting, done right.",
   "sub": "Owner portal and PPRA-aware trust accounting on Growth.",
   "body": "Owner portal and PPRA-aware trust accounting come standard on Growth.\n\nEvery rand reconciled to a double-entry ledger. Owner statements without spreadsheets.\n\n{link}"
  },
  {
   "id": "d4-1212",
   "d": 3,
   "t": "12:12",
   "b": "tanos",
   "k": "tenant",
   "hook": "Maintenance without the voice notes.",
   "sub": "Tenants log it with photos. You assign it and close it.",
   "body": "Tenants log a maintenance ticket in _tanos, with photos. You see it, assign it, close it.\n\nOne record instead of fifty voice notes.\n\n{link}"
  },
  {
   "id": "d4-1919",
